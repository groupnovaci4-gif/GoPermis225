# Copier vers backend/.env — NE JAMAIS committer le .env réel
MONGO_URL=mongodb://localhost:27017
DB_NAME=gopermis225

# Obligatoires : le serveur refuse de démarrer sans eux.
# Générer avec : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Durée de vie des jetons (minutes). 720 = 12 h.
JWT_EXPIRE_MINUTES=720

# Origines autorisées pour le navigateur, séparées par des virgules.
CORS_ORIGINS=http://localhost:5173

# Verrou anti-force-brute : nombre d'échecs avant blocage temporaire.
LOGIN_MAX_FAILS=5
LOGIN_LOCK_SECONDS=900
